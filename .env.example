# Copy to .env (or run ./setup.sh, which writes this for you) and fill in.
# One .env per machine — this is what makes each container answer to its
# own subdomain and its own place in object storage.

# Required. The subdomain this machine serves, e.g. stream1.example.com
DOMAIN=

# Host-side ports for this instance. Defaults (8080/1935) are fine for a
# single deployment on a dedicated machine. Running more than one
# deployment on the same machine? Give each its own directory (see
# "Multiple deployments on one machine" in the README) and its own
# HTTP_PORT/RTMP_PORT here so they don't collide.
#
# HTTP_BIND defaults to 127.0.0.1: this container's plain-HTTP port isn't
# meant to be reachable from the internet directly - put a reverse proxy
# (nginx, Caddy, ...) in front for TLS and routing, see nginx-vhost.sh.
# Set HTTP_BIND=0.0.0.0 instead if this machine has nothing else running
# and you want to expose HTTP_PORT directly.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# RTMP is a raw TCP protocol, not HTTP - it can't go through the same
# reverse proxy path as HTTP_PORT above, so it's always bound to
# 0.0.0.0. Give each concurrent deployment on one machine its own value.
RTMP_PORT=1935

# How this container's HTTPS gets handled - one of:
#   proxy       (default) nothing - terminate TLS in front of this
#               container yourself (see nginx-vhost.sh). No :443 here.
#   manual      you supply the cert: place fullchain.pem/privkey.pem at
#               /etc/letsencrypt/live/<DOMAIN>/ on the certs-data volume
#               (see docker-compose.tls.yml) before or after first start.
#   letsencrypt this container requests and renews its own cert via
#               certbot. DOMAIN's public DNS must already point here,
#               and ports 80 + 443 must be reachable from the internet
#               (see docker-compose.tls.yml). Requires LETSENCRYPT_EMAIL.
# manual/letsencrypt both need:
#   docker compose -f docker-compose.yml -f docker-compose.tls.yml up -d
TLS_MODE=proxy

# Required if TLS_MODE=letsencrypt - used for Let's Encrypt renewal/
# expiry notices, nothing else.
LETSENCRYPT_EMAIL=

# Host port for HTTPS when TLS_MODE=manual/letsencrypt (docker-compose.tls.yml).
HTTPS_PORT=443

# Seeds one initial stream key (the secret the encoder publishes with:
# rtmp://<DOMAIN>/stream/<STREAM_KEY>). Leave blank to auto-generate one,
# printed once in `docker compose logs` on first start. Its playback id
# (the public id used in HLS/DASH/recording-control URLs — deliberately
# not the same value, so it can't be used to publish) is derived
# automatically and printed alongside it.
#
# This is just the one key needed to get started. Mint more any time,
# for more concurrent streams from this same machine, with no restart:
#   docker exec <container> mint-key.sh
#   docker exec <container> revoke-key.sh <stream_key>
# or from another backend, over HTTP (see ADMIN_API_TOKEN below):
#   POST   /admin/keys
#   DELETE /admin/keys/<stream_key>
STREAM_KEY=

# Bearer token for the /admin/keys API above, so another backend can mint
# and revoke stream keys without shell access to this machine. Leave
# blank to auto-generate one, printed once in `docker compose logs` on
# first start. Put this domain behind HTTPS before relying on this - it's
# a plain secret on the wire otherwise.
ADMIN_API_TOKEN=

# DigitalOcean Spaces (or any S3-compatible endpoint: AWS S3, Backblaze
# B2, MinIO, ...). Leave all four blank to keep recordings local-only
# under /tmp/rec (the rec-data docker volume).
SPACES_ENDPOINT=fra1.digitaloceanspaces.com
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
# key prefix inside the bucket: <prefix>/<domain>/<file>.mp4
SPACES_PREFIX=recordings

# The recording log (/data/record-done.log) records every session event
# and the reason behind any failed recording. It lives on the /data volume
# so it survives a restart, and is rotated in place once it passes
# REC_LOG_MAX_BYTES, keeping REC_LOG_KEEP older files alongside it
# (record-done.log.1 .. .N). Defaults below; a rotation costs at most one
# log line.
#REC_LOG_MAX_BYTES=5242880
#REC_LOG_KEEP=3

# Status webhook, POSTed here as two different payload shapes, both
# Authorization: Bearer <WEBHOOK_TOKEN>, so a backend doesn't have to
# poll for either:
#   rec-finalize.sh:  {"key","status","size"} once a recording finishes
#                      uploading (status "ready" or "failed"), plus an
#                      optional "reason" slug and "video_codec" - see the
#                      README's Status webhooks section
#   record-start.cgi / rec-finalize.sh:
#                     {"playback_id","recording"} when a camera starts
#                      or stops recording
# Note that a publisher dropping out mid-recording does NOT send
# "recording":false - the recording resumes by itself when the encoder
# reconnects, and only one "ready" is ever sent per start/stop pair, for
# the single joined-up file. See RESUME_TIMEOUT below.
# Leave WEBHOOK_URL blank to skip both.
WEBHOOK_URL=https://api.sporty.plus/api/webhook/video-status
WEBHOOK_TOKEN=

# /control API basic auth (start/stop recording, drop publishers, ...).
# Leave CONTROL_PASS blank to auto-generate a random password, printed
# once in `docker compose logs` on first start.
CONTROL_USER=admin
CONTROL_PASS=

# How long a recording waits for a dropped publisher to come back before
# giving up, in seconds. Under this, the encoder reconnecting simply
# resumes the recording and the booking ends up as one continuous file;
# over it, whatever was recorded before the drop is joined up, uploaded
# and reported as finished, exactly as if /control/record/stop had been
# called. Set it comfortably longer than the worst reconnect you expect
# from your cameras and shorter than the gap between bookings.
RESUME_TIMEOUT=600

# Housekeeping for the recordings volume (/tmp/rec), which otherwise
# collects the leftovers of recordings that failed to upload or were
# killed mid-write. CLEANUP_INTERVAL is how often the sweep runs, in
# seconds; RECORDING_RETENTION_DAYS is how old a file must be before it's
# considered at all. The sweep only deletes files it can confirm were
# uploaded (plus zero-byte recordings); anything that never made it to
# object storage is reported and kept until someone runs
# `docker exec <container> cleanup-recordings.sh --force`.
CLEANUP_INTERVAL=3600
RECORDING_RETENTION_DAYS=7

# Keep the local .flv/.mp4 in /tmp/rec after a successful upload instead
# of deleting them.
KEEP_LOCAL_RECORDINGS=false
