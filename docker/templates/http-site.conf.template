server {
    listen       80;
    server_name  ${DOMAIN};

    # ACME HTTP-01 challenge, answered by certbot's webroot plugin when
    # TLS_MODE=letsencrypt (see docker-entrypoint.sh). Harmless, unused
    # static location in TLS_MODE=proxy/manual.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    include /usr/local/nginx/conf/site-locations/${DOMAIN}.conf;
}
