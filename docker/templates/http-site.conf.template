server {
    listen       80;
    server_name  ${DOMAIN};

    # --- HLS playback: /hls/<playback_id>.m3u8 ------------------------
    location /hls {
        types {
            application/vnd.apple.mpegurl m3u8;
            video/mp2t              ts;
        }
        root /tmp;
        add_header Cache-Control no-cache always;
        add_header Access-Control-Allow-Origin * always;
    }

    # --- DASH playback: /dash/<playback_id>.mpd -----------------------
    location /dash {
        types {
            application/dash+xml mpd;
            video/mp4             m4s mp4;
        }
        root /tmp;
        add_header Cache-Control no-cache always;
        add_header Access-Control-Allow-Origin * always;
    }

    # --- ingest key check, called by rtmp/on_publish (loopback only) --
    # Encoders publish to stream/<playback_id>?key=<stream_key> - nginx-rtmp
    # hands the callback $name (the playback_id part of the path) and
    # $arg_key (the secret) separately, so there's no rename step: the
    # stream is under its playback_id from the moment it connects, and the
    # secret key never appears in HLS/DASH paths, /stat, /control, or
    # recordings. $keyed_playback_id comes from the stream_keys.map lookup
    # (docker/nginx.conf) — any key minted via `docker exec <container>
    # mint-key.sh` is accepted, each with its own playback id, so this one
    # domain can carry multiple concurrent streams. Reject if the key is
    # unknown, or if it's being used to claim a playback_id it doesn't own.
    location = /auth/publish {
        allow 127.0.0.1;
        deny all;
        if ($keyed_playback_id = "") {
            return 403;
        }
        if ($arg_name != $keyed_playback_id) {
            return 403;
        }
        return 200;
    }

    # --- rtmp-module stats (XML + XSL view) --------------------------
    location /stat {
        rtmp_stat all;
        rtmp_stat_stylesheet stat.xsl;
    }

    location = /stat.xsl {
        root html;
    }

    # --- start recording, with an optional custom output filename -----
    # nginx-rtmp's control module has no concept of a caller-supplied
    # filename, so this exact-match location takes priority over the
    # generic /control below and routes just the start call through
    # record-start.cgi, which stashes ?filename=... (if given) keyed by
    # playback_id, then forwards the real start to the loopback-only
    # /internal/control/record/start. record-done.sh picks the stashed
    # name back up when the recording finishes (see rtmp-site template).
    #   GET /control/record/start?app=stream&name=<playback_id>&rec=rec1[&filename=<name>]
    location = /control/record/start {
        auth_basic           "stream control";
        auth_basic_user_file /usr/local/nginx/conf/control.htpasswd;

        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /usr/local/bin/record-start.cgi;
        fastcgi_param RTMP_APP      $arg_app;
        fastcgi_param RTMP_NAME     $arg_name;
        fastcgi_param RTMP_REC      $arg_rec;
        fastcgi_param RTMP_FILENAME $arg_filename;
        fastcgi_pass unix:/run/fcgiwrap.sock;
    }

    # real record/start trigger, reachable only from record-start.cgi
    location = /internal/control/record/start {
        allow 127.0.0.1;
        deny all;
        rtmp_control all;
    }

    # --- rtmp-module control API ---------------------------------------
    # stop recording, drop publishers, etc. (start is handled above).
    # Used by the Start/Stop Recording buttons on the player page. Always
    # behind basic auth in this image — see docker-entrypoint.sh for how
    # the password is set.
    #   GET /control/record/stop?app=stream&name=<playback_id>&rec=rec1
    location /control {
        rtmp_control all;
        auth_basic           "stream control";
        auth_basic_user_file /usr/local/nginx/conf/control.htpasswd;
    }

    # --- local recordings (fallback / debug view; the primary copy
    # normally ends up in object storage, see record-done.sh) -----------
    location /recordings {
        alias /tmp/rec/;
        autoindex on;
        allow 127.0.0.1;
        deny all;
    }

    # --- key-management API for external backends ----------------------
    # POST   /admin/keys               mint a key, see admin-api.cgi
    # DELETE /admin/keys/<stream_key>  revoke a key
    # Auth is a bearer token checked inside admin-api.cgi (see
    # docker-entrypoint.sh), not an IP allow-list — an external backend
    # needs to reach this from wherever it runs. Put this domain behind
    # HTTPS before using it for real; the token is a plain secret on the
    # wire otherwise.
    location /admin {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /usr/local/bin/admin-api.cgi;
        fastcgi_pass unix:/run/fcgiwrap.sock;
    }

    # --- simple test player -------------------------------------------
    location / {
        root   html;
        index  player.html index.html;
    }
}
