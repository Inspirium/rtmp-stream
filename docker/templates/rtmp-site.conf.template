# RTMP ingest for ${DOMAIN}
#
# Mint a stream key: docker exec <container> mint-key.sh
# Publish (encoder / OBS):  rtmp://${DOMAIN}/stream/<playback_id>?key=<stream_key>
# Playback (HLS):           http://${DOMAIN}/hls/<playback_id>.m3u8
# Playback (DASH):          http://${DOMAIN}/dash/<playback_id>.mpd
# Stats:                    http://${DOMAIN}/stat
# Recording start/stop:     GET /control/record/start?app=stream&name=<playback_id>&rec=rec1[&filename=<name>]
#                            GET /control/record/stop?app=stream&name=<playback_id>&rec=rec1
#
# Every minted stream_key has its own one-way-derived playback_id (see
# stream_keys.map / mint-key.sh). The encoder's publish path already
# carries the public playback_id — nginx-rtmp splits off the ?key=...
# part on its own, so /auth/publish just checks that key is allowed to
# claim that playback_id (see http-site.conf.template). The secret key
# itself never becomes the stream's name, so it never appears in
# HLS/DASH paths, /stat, /control, or recordings, and because each key
# maps to its own playback_id, this one domain can carry several
# concurrent streams at once.

server {
    listen 1935;
    chunk_size 4096;

    application stream {
        live on;

        # keep segments aligned to keyframes so HLS/DASH players don't stall
        wait_key on;
        wait_video on;

        # validated against stream_keys.map by /auth/publish (see
        # http-site.conf.template) - the ?key=... query param nginx-rtmp
        # parses off the publish path is what gets checked
        on_publish http://127.0.0.1/auth/publish;
        notify_method get;

        # Fires on every publish - the first connect of a stream and, just
        # as importantly, every reconnect after the encoder dropped. If a
        # recording session is still open for this playback_id,
        # record-resume.sh starts recording again immediately, so a booking
        # survives a flaky uplink instead of ending at the first blip. Does
        # nothing for a stream nobody asked to record. See rec-session.sh.
        exec_publish /usr/local/bin/record-resume.sh $name;

        # written flat (no per-app subdir) so they map 1:1 onto the
        # /hls and /dash http locations, e.g. /hls/<playback_id>.m3u8
        hls on;
        hls_path /tmp/hls;
        # Fragments only close on a keyframe (wait_key on), so hls_fragment
        # is a FLOOR, not a target: the real fragment length is the first
        # keyframe at or after 1s. Encoders must publish a 1s keyframe
        # interval (Dahua: I Frame Interval = frame rate) or fragments -
        # and latency - grow to the encoder's GOP regardless of what's set
        # here. A camera pushing a long-GOP profile was producing 25s
        # fragments against the old 3s setting.
        #
        # Players target ~3x EXT-X-TARGETDURATION, and nginx-rtmp writes
        # that as the MAX fragment duration in the window (floored at
        # hls_fragment), so one long fragment raises latency for the whole
        # window until it ages out.
        #
        # These two must move together: the window is a fragment COUNT,
        # winfrags = hls_playlist_length / hls_fragment, fixed at config
        # parse. hls_cleanup keeps winfrags*2+1 fragments on disk, and
        # /tmp/hls is neither a volume nor swept by cleanup-recordings.sh.
        # Shortening hls_fragment alone multiplies both the manifest and
        # the on-disk retention - 60s/3s kept 41 fragments, 60s/1s would
        # keep 121. 20s/1s holds it at the same 20-fragment window.
        hls_fragment 1s;
        hls_playlist_length 20s;
        hls_cleanup on;

        dash on;
        dash_path /tmp/dash;
        dash_fragment 3s;
        dash_playlist_length 60s;
        dash_cleanup on;

        # Recording is manual only (started/stopped via /control, see
        # above) — nothing is recorded just by publishing. nginx-rtmp
        # writes the raw copy as flv; exec_record_done hands it to
        # record-done.sh.
        #
        # One /control/record/start .. /control/record/stop pair is one
        # *session*, but not necessarily one file: nginx-rtmp closes the
        # .flv whenever the publisher goes away and can't reopen it, so a
        # session that outlives a reconnect ends up as several parts.
        # record-done.sh banks them and ffmpeg joins them into a single
        # seekable .mp4 at stop time - named from ?filename=... if the
        # start call set one - which is then uploaded to object storage if
        # SPACES_* was set up. See rec-session.sh for the state machine
        # and docker-entrypoint.sh for the storage side.
        #
        # Everything record-done.sh needs beyond these two arguments
        # (domain, bucket, prefix, upload/keep flags) it reads from
        # /data/.rec-config, which docker-entrypoint.sh writes at startup.
        recorder rec1 {
            record all manual;
            record_suffix -%Y-%m-%d-%H-%M-%S.flv;
            record_path /tmp/rec;
            record_unique on;

            exec_record_done /usr/local/bin/record-done.sh $path $name;
        }
    }
}
